{
  "version": 1,
  "author": "ntc-led-buzzer",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-ntc-temperature-sensor", "id": "ntc1", "top": -120, "left": 150, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": -110, "left": 270, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -50, "left": 270, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-buzzer", "id": "bz1", "top": 40, "left": 330, "attrs": { "volume": "0.1" } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 130, "left": 330, "attrs": { "color": "red" } }
  ],
  "connections": [
    ["esp:3V3", "ntc1:VCC", "red", ["v0"]],
    ["esp:GND.1", "ntc1:GND", "black", ["v0"]],
    ["esp:D34", "ntc1:OUT", "green", ["v0"]],
    ["esp:D18", "led1:A", "orange", ["v0"]],
    ["led1:C", "r1:1", "orange", ["v0"]],
    ["r1:2", "esp:GND.1", "black", ["v0"]],
    ["esp:D19", "bz1:2", "purple", ["v0"]],
    ["bz1:1", "esp:GND.1", "black", ["v0"]],
    ["esp:D4", "btn1:1.l", "blue", ["v0"]],
    ["btn1:2.l", "esp:GND.1", "black", ["v0"]]
  ],
  "dependencies": {}
}
